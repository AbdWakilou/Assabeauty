# ============================================================
# VARIABLES D'ENVIRONNEMENT — SalonPro
# Copier ce fichier en .env et remplir les valeurs
# Ne JAMAIS commiter le .env — il est dans .gitignore
# ============================================================

# Firebase — https://console.firebase.google.com
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin SalonPro — Espace administrateur (/admin)
VITE_ADMIN_LOGIN=admin@salonpro.app
VITE_ADMIN_PASSWORD=SalonProAdmin2026!

# FedaPay — https://fedapay.com
# Netlify Functions uniquement (pas de VITE_ prefix = pas exposé au browser)
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxx
FEDAPAY_WEBHOOK_SECRET=your_webhook_secret

# Firebase Admin (pour les Netlify Functions)
FIREBASE_PROJECT_ID=your_project_id
# Coller le JSON du service account sur UNE SEULE LIGNE
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# URL de callback après paiement
CALLBACK_URL=https://votre-site.netlify.app/app/parametres?status=success

# Environnement : "live" en prod, laisser vide en sandbox
ENVIRONMENT=
