rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // L'utilisateur est propriétaire du salon si son doc users/{uid}
    // contient le bon salonId. (Vérifié seulement si users/{uid} existe.)
    function ownsSalon(salonId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.salonId == salonId;
    }

    // ── Users ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId);
      // ⚠️  allow create sans vérifier users/{uid} (il n'existe pas encore)
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // jamais
    }

    // ── Salons et sous-collections ─────────────────────────────────
    match /salons/{salonId} {
      // ⚠️  allow create : vérifier que le demandeur se déclare gérant
      //     (users/{uid} existe déjà car on l'écrit EN PREMIER dans handleFinish)
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['nom', 'refAffilie'])
        && ownsSalon(salonId);
      allow read:   if ownsSalon(salonId);
      allow update: if ownsSalon(salonId);
      allow delete: if false;

      match /{collection}/{docId} {
        allow read, write: if ownsSalon(salonId);
      }
    }

    // ── Inscriptions (log d'affiliation) ──────────────────────────
    match /inscriptions/{userId} {
      // Écriture uniquement par le propriétaire de ce userId,
      // lecture réservée à l'admin (Netlify Function via service account)
      allow create: if isOwner(userId);
      allow read:   if false; // accès admin via service account seulement
      allow update, delete: if false;
    }

    // ── Affiliés ──────────────────────────────────────────────────
    match /affilies/{affilieId} {
      allow read:   if isOwner(affilieId);
      allow create: if isOwner(affilieId)
        && request.resource.data.keys().hasAll(['code', 'statut', 'email']);
      // update limité : un affilié ne peut pas modifier son propre taux ni son statut
      allow update: if isOwner(affilieId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['taux', 'statut', 'commissionsGagnees', 'commissionsPendantes']);
      allow delete: if false;
    }

    // ── Événements commissions ─────────────────────────────────────
    // Écriture uniquement depuis le backend (Netlify Function / service account)
    // Lecture uniquement par l'affilié concerné
    match /evenements_commissions/{eventId} {
      allow read:   if isAuthenticated()
        && resource.data.affilieId == request.auth.uid;
      allow write:  if false; // backend only via service account
    }
  }
}
